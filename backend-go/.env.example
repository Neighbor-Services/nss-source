# ==============================================================================
# Neighbor Service (NSA) — Go Backend Environment Template
# backend-go/.env.example
# Copy to .env and fill in real values before running.
# ==============================================================================

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=8000
ENV=development               # development | staging | production
ENVIRONMENT=development       # alias used by some middleware checks

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
DB_DRIVER=postgres
POSTGRES_DB=ns_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Full DSN — overrides individual POSTGRES_* values when set
DATABASE_URL=postgres://postgres:your_secure_db_password@localhost:5432/ns_db?sslmode=disable
DB_DSN=postgres://postgres:your_secure_db_password@localhost:5432/ns_db?sslmode=disable

# ── Authentication & JWT ───────────────────────────────────────────────────────
SECRET_KEY=generate_a_secure_random_secret_key_here
JWT_SECRET=generate_a_secure_random_secret_key_here
JWT_REFRESH_SECRET=generate_a_secure_random_refresh_secret_here
JWT_ACCESS_EXPIRY_HOURS=24
JWT_REFRESH_EXPIRY_DAYS=30

# ── CORS Allowed Origins (comma-separated) ────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:4201,http://localhost:8000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:4200,https://neighborservice.com,https://www.neighborservice.com,https://admin.neighborservice.com,https://api.neighborservice.com,https://staging.neighborservice.com,https://staging-admin.neighborservice.com,https://staging-api.neighborservice.com

# ── Admin IP Allowlist (optional, comma-separated; leave blank to disable) ────
ADMIN_ALLOWED_IPS=

# ── Frontend URL (used in emails & OAuth redirects) ───────────────────────────
FRONTEND_URL=https://neighborservice.com

# ── Stripe Payments & Connect ──────────────────────────────────────────────────
STRIPE_PUBLIC_KEY=pk_live_your_stripe_public_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ── Video / Audio Consultations (Agora RTC) ───────────────────────────────────
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# ── Background Screening & Identity Verification (Checkr) ────────────────────
CHECKR_API_KEY=your_checkr_api_key
CHECKR_WEBHOOK_SECRET=your_checkr_webhook_secret

# ── Media & Storage ────────────────────────────────────────────────────────────
MEDIA_UPLOAD_DIR=./media
MEDIA_ROOT=./media
# In monorepo dev, the Go backend can serve the Django media directory:
# MEDIA_ROOT=../backend/media

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
EMAIL_HOST=mail.neighborservice.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=admin@neighborservice.com
EMAIL_HOST_PASSWORD=your_smtp_password
DEFAULT_FROM_EMAIL=Neighbor Service Team <noreply@neighborservice.com>
ADMIN_EMAIL=admin@neighborservice.com

# ── Firebase Cloud Messaging (Push Notifications) ─────────────────────────────
# Path to Firebase service account JSON key file
FIREBASE_CREDENTIALS_FILE=./firebase-service-account.json
# Alternative: inline JSON string (takes precedence over file if set)
# FIREBASE_CREDENTIALS_JSON=
# Standard Google ADC path (also checked by the Firebase SDK)
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# ── APNS (Apple Push Notifications) ───────────────────────────────────────────
# Apple Push Notification Service credentials for iOS push notifications
APNS_KEY_ID=5FHM449W5T
APNS_TEAM_ID=875W85H2Q9
APNS_BUNDLE_ID=com.neighborservicesolutionsllc.nsapp
APNS_KEY_PATH=./apns.p8
APNS_USE_SANDBOX=True

# ── Redis Cache & Token Blacklist ──────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_ADDR=127.0.0.1:6379
# REDIS_URL=redis://localhost:6379/0

# ── Apple App Store In-App Purchases (IAP) ────────────────────────────────────
# Generate from: App Store Connect → App → In-App Purchases → App-Specific Shared Secret
APPLE_SHARED_SECRET=your_apple_app_specific_shared_secret

# ── Google Play In-App Purchases & Billing ────────────────────────────────────
ANDROID_PACKAGE_NAME=com.neighborservicesolutionsllc.nsapp
# Path to or inline JSON of Google Play service account key
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
